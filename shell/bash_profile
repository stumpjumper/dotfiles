# Login bash.
# ~/.profile may or may not source .bashrc:
#   Debian/Ubuntu — it does (and install.sh skips creating this file).
#   aal on turbo — it only prepends MacPorts PATH, so we must source
#   .bashrc ourselves. Always fall through to .bashrc if it has not
#   already run.

if [ -f "$HOME/.profile" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.profile"
fi
if [ -z "${DOTFILES_BASHRC_SOURCED:-}" ] && [ -f "$HOME/.bashrc" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.bashrc"
fi
