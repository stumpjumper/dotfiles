# Interactive bash. Login shells reach here via bash_profile.
# Non-interactive bash returns immediately.

case $- in
  *i*) ;;
  *) return ;;
esac
DOTFILES_BASHRC_SOURCED=1

export PATH="$HOME/bin:$PATH"

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
if [ "$(uname -s)" = Darwin ]; then
  # shellcheck disable=SC1091
  . "$DOTFILES/shell/path_darwin.sh"
fi
[ -f "$DOTFILES/shell/aliases.sh" ] && . "$DOTFILES/shell/aliases.sh"
[ -f "$HOME/.config/dotfiles/local.sh" ] && . "$HOME/.config/dotfiles/local.sh"

if [ -z "${BASH_COMPLETION_VERSINFO:-}" ] && [ -z "${POSIXLY_CORRECT:-}" ]; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    # shellcheck disable=SC1091
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    # shellcheck disable=SC1091
    . /etc/bash_completion
  fi
fi

# local.sh may set DOTFILES_PROMPT_LABEL to replace the hostname. Two
# asset numbers like s1135912 and s1124692 are too easy to mix up.
# DOTFILES_PROMPT_COLOR: cyan, yellow, green, or magenta.
if [ -n "${DOTFILES_PROMPT_LABEL:-}" ]; then
  case ${DOTFILES_PROMPT_COLOR:-cyan} in
    yellow) _dotfiles_prompt_color=33 ;;
    green) _dotfiles_prompt_color=32 ;;
    magenta) _dotfiles_prompt_color=35 ;;
    *) _dotfiles_prompt_color=36 ;;
  esac
  PS1="\[\e[${_dotfiles_prompt_color}m\]${DOTFILES_PROMPT_LABEL}\[\e[0m\] \u:\w\$ "
  unset _dotfiles_prompt_color
else
  PS1='\u@\h:\w\$ '
fi

# Emacs C-d is delete-char. In bash, Ctrl-D on an empty line is EOF and
# exits the shell, which makes Herdr close the tab. Refuse that.
set -o ignoreeof
