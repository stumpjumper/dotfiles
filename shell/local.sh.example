# Copy to ~/.config/dotfiles/local.sh (not in git).
# Sourced from zshenv (every zsh, including non-interactive ssh) and
# from interactive bashrc. Keep this to PATH and env; aliases live in
# shell/aliases.sh.
#
# nano (docker CLI on PATH for aal's `ssh nano@localhost` context):
#   export PATH="/usr/local/bin:$PATH"
#
# bun / pnpm / grok / nanoclaw belong here, not in the shared zshrc.
#
# Completions that need `compdef` (bun): guard with DOTFILES_POST_COMPINIT.
# zshrc re-sources this file after compinit.
#
# Prompt label, optional. Replaces the hostname so similar asset names
# are not what you read. Color: cyan, yellow, green, or magenta.
#   DOTFILES_PROMPT_LABEL=studio
#   DOTFILES_PROMPT_COLOR=cyan
