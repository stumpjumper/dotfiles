# Interactive zsh. bun / pnpm / grok / nanoclaw stay in
# ~/.config/dotfiles/local.sh — not here.

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
if [ "$(uname -s)" = Darwin ]; then
  # shellcheck disable=SC1091
  . "$DOTFILES/shell/path_darwin.sh"
  [ -d /opt/homebrew/share/zsh/site-functions ] && \
    fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
  # Stale Intel Homebrew completions (Apple Silicon uses /opt/homebrew)
  fpath=( ${fpath:#/usr/local/share/zsh*} )
fi
[ -f "$DOTFILES/shell/aliases.sh" ] && . "$DOTFILES/shell/aliases.sh"

autoload -Uz compinit && compinit -u

# Overlay may register completions (e.g. bun) that need compdef.
if [ -f "$HOME/.config/dotfiles/local.sh" ]; then
  DOTFILES_POST_COMPINIT=1
  # shellcheck disable=SC1091
  . "$HOME/.config/dotfiles/local.sh"
  unset DOTFILES_POST_COMPINIT
fi

# See bashrc. Shape: studio(3) .../grok_mac_care$
if [ -n "${DOTFILES_PROMPT_LABEL:-}" ]; then
  # shellcheck disable=SC1091
  . "$DOTFILES/shell/prompt.sh"
  case ${DOTFILES_PROMPT_COLOR:-cyan} in
    yellow|green|magenta|cyan) _dotfiles_prompt_color=$DOTFILES_PROMPT_COLOR ;;
    *) _dotfiles_prompt_color=cyan ;;
  esac
  _dotfiles_cmd_count=0
  _dotfiles_prompt_precmd() {
    local d
    _dotfiles_cmd_count=$((_dotfiles_cmd_count + 1))
    d=$(_dotfiles_prompt_dir)
    d=${d//%/%%}
    d=${d//\\/\\\\}
    _dotfiles_prompt_dir_val=$d
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _dotfiles_prompt_precmd
  setopt prompt_subst
  PS1="%F{${_dotfiles_prompt_color}}%B${DOTFILES_PROMPT_LABEL}%b%f(\${_dotfiles_cmd_count}) \${_dotfiles_prompt_dir_val}\$ "
  unset _dotfiles_prompt_color
else
  PS1='%n@%m:%~%# '
fi
